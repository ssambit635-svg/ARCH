# ARCH local LLM profile — optional, for AI_PROVIDER="arch-hybrid".
#
#   ollama pull qwen2.5-coder:7b
#   ollama create arch-copilot -f ai/Modelfile          # (docker: -f /arch-ai/Modelfile)
#   LOCAL_LLM_MODEL="arch-copilot"
#
# Qwen2.5-Coder-7B-Instruct (Apache-2.0) at Q4 needs ~5-6 GB RAM and runs on CPU. It is strong at
# code and at following JSON schemas. Smaller machines: qwen2.5-coder:3b (non-commercial Qwen
# research licence — check it) or llama3.2:3b. Swap FROM for a fine-tuned GGUF once you have one
# (see docs/engineering/ARCH-MODEL.md → "Fine-tuning the local LLM").
FROM qwen2.5-coder:7b

# Low temperature: incident drafts must be factual, not creative.
PARAMETER temperature 0.2
PARAMETER top_p 0.9
PARAMETER repeat_penalty 1.05
PARAMETER num_ctx 8192

SYSTEM """You are ARCH Copilot, the incident-response assistant built into ARCH. You work only from the incident data and code you are given, never invent facts, and answer in the exact JSON format requested."""
