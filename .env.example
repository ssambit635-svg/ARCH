# ARCH — example environment file
#
# Copy to `.env` for local development:  cp .env.example .env
# NEVER commit `.env`. It is ignored by .gitignore, and it should stay that way.
#
# Generate secrets with:  openssl rand -base64 32
# Each secret must be unique per environment. Do not reuse production values locally.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local Docker PostgreSQL (see docker-compose.yml). Must include ?schema=public.
DATABASE_URL="postgresql://arch:arch@localhost:5432/arch"

# ---------------------------------------------------------------------------
# Authentication (Auth.js / NextAuth v5)
# ---------------------------------------------------------------------------
# Signs session cookies. Rotating this signs every user out of every session.
AUTH_SECRET="replace-with-openssl-rand-base64-32"

# Public base URL of the app. Used for callbacks, invitations and links in emails.
APP_URL="http://localhost:3000"

# Optional OAuth provider (GitHub sign-in). Leave blank to disable the provider.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ---------------------------------------------------------------------------
# Inbound webhooks
# ---------------------------------------------------------------------------
# MUST be different from AUTH_SECRET. Used to verify HMAC signatures on
# POST /api/webhooks/:provider. Rotating this invalidates inbound webhooks until
# senders are updated — coordinate before changing it in production.
AUTH_SECRET_WEBHOOK="replace-with-a-different-openssl-rand-base64-32"

# Max accepted clock skew for webhook timestamps, in seconds (replay protection).
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS="300"

# ---------------------------------------------------------------------------
# Email (notifications)
# ---------------------------------------------------------------------------
# Empty = console logging in development (no email is actually sent).
# Set to "resend" (or another adapter) in staging/production.
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
# From address for notification emails. Must be a verified sender/domain.
EMAIL_FROM="ARCH <notifications@localhost>"

# ---------------------------------------------------------------------------
# Observability (optional in development)
# ---------------------------------------------------------------------------
ERROR_TRACKING_DSN=""
LOG_LEVEL="debug"

# ---------------------------------------------------------------------------
# Feature flags (see docs/product/ROADMAP.md — keep v1 surface small)
# ---------------------------------------------------------------------------
# Enable the public status page rendering path. Set to "false" to hide all /status/* routes.
FEATURE_STATUS_PAGES="true"
# Enable outbound Slack notifications (planned for v1.1).
FEATURE_SLACK_NOTIFICATIONS="false"
