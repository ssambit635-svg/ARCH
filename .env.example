# ARCH — example environment file
#
# Copy to `.env` for local development:  cp .env.example .env && chmod 600 .env
# NEVER commit `.env`. It is ignored by .gitignore, and it should stay that way.
# If it was committed before, remove it from Git tracking AND rotate every exposed secret:
# .gitignore cannot remove content from past Git commits.
#
# Generate secrets with:  openssl rand -base64 32
# Each secret must be unique per environment. Do not reuse production values locally.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local-only PostgreSQL (Docker or embedded; see docker-compose.yml). Do NOT use this
# password or database for a public deployment. Production uses a managed Postgres URL.
DATABASE_URL="postgresql://arch:arch@localhost:5432/arch"

# Demo data is OFF by default. In a private, disposable dev environment only, set this
# to "true" AND choose a unique 12+ character SEED_PASSWORD before starting dev:all.
# Seed users have access to demo organizations: never expose a known demo password.
ARCH_SEED_DEMO="false"
SEED_PASSWORD=""

# ---------------------------------------------------------------------------
# Authentication (Auth.js / NextAuth v5)
# ---------------------------------------------------------------------------
# Signs session cookies. Rotating this signs every user out. Legacy v1 webhook
# endpoint secrets were encrypted with this key: rekey them first (see README).
AUTH_SECRET="replace-with-openssl-rand-base64-32"

# Public base URL of the app. Used for callbacks, invitations and links in emails.
APP_URL="http://localhost:3000"

# Optional OAuth provider (GitHub sign-in). Leave blank to disable the provider.
# To turn it on, create an OAuth App at https://github.com/settings/developers:
#   Homepage URL:      http://localhost:3000   (APP_URL)
#   Callback URL:      http://localhost:3000/api/auth/callback/github
# For a browser preview use its actual PUBLIC HTTPS host (not localhost) for both URLs;
# reconfigure the OAuth App if the preview host changes. See docs/GITHUB-OAUTH-SETUP.md.
# Then paste the Client ID / Client secret below — "Continue with GitHub" on /login
# appears as soon as both are set. Use a verified GitHub email. If this email already has
# an ARCH password account, sign in with your password and link GitHub in Settings.
# These are NOT GITHUB_TOKEN: the latter is an optional, separate PAT for creating PRs.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ---------------------------------------------------------------------------
# Inbound webhooks
# ---------------------------------------------------------------------------
# MUST differ from AUTH_SECRET. Encrypts NEW webhook endpoint HMAC secrets (v2) in
# the DB; senders sign with their own per-endpoint whsec_... key, not this value.
# Rekey existing envelopes BEFORE rotating this in production or reissue endpoints.
AUTH_SECRET_WEBHOOK="replace-with-a-different-openssl-rand-base64-32"

# Max accepted clock skew for webhook timestamps, in seconds (replay protection).
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS="300"

# ---------------------------------------------------------------------------
# Email (notifications)
# ---------------------------------------------------------------------------
# Empty = console logging in development (no email is actually sent).
# Set to "resend" (or another adapter) in staging/production.
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
# From address for notification emails. Must be a verified sender/domain.
EMAIL_FROM="ARCH <notifications@localhost>"

# ---------------------------------------------------------------------------
# ARCH Copilot + Code Assist — ARCH's own AI (V3, see docs/engineering/ARCH-MODEL.md)
# ---------------------------------------------------------------------------
# There is no external AI in ARCH: no OpenAI, no Anthropic, no Ollama, no hybrid mode.
# The only engines are the ones compiled into this repository.
# "arch" (default)  ARCH's own model: trained on your resolved incidents, runs on this server's
#                   CPU. Free, no GPU, no API key, no network. Incident data never leaves.
#                   Complex prompts additionally go through the built-in agent loop
#                   (task planner -> native tools -> sandboxed Python self-correction).
# "mock"            canned drafts for tests. Any other value fails at boot.
# AI output is ALWAYS a draft: nothing is posted until a responder approves it.
AI_PROVIDER="arch"
# Privacy lock (default on): blocks fetching public URLs when ingesting knowledge documents.
# External AI vendors are not a setting at all — that code path does not exist.
ARCH_OFFLINE_ONLY="true"
AI_MAX_TOKENS="1000"
# Per attempt. Each call is retried once, then the user sees a friendly error.
AI_TIMEOUT_MS="15000"
# Per-organization budget of AI calls per minute (Copilot + Code Assist).
AI_RATE_LIMIT_PER_MINUTE="20"

# ARCH Agent (built in): the directory list/read tools are confined to. Never contains secrets.
ARCH_AGENT_WORKDIR="model-data"
# Self-correction loop: how often a failed .py script is sent back to the engine with its error.
ARCH_AGENT_MAX_FIX_ATTEMPTS="3"

# ARCH model training data. The fetchers store downloaded corpora here; the folder is git-ignored.
#   npm run model:fetch-public   public postmortems            -> public-incidents.jsonl
#   npm run model:fetch-code     SWE-bench + ManySStuBs4J       -> code-corpus.jsonl
#   npm run model:fetch-review   github-codereview + CodeReviewer -> review-corpus.jsonl
# Licenses live in docs/legal/TRAINING-DATA-LICENSES.md; nothing third-party is committed.
ARCH_MODEL_DATA_DIR="model-data"
# The worker enqueues + runs training for organizations that resolved incidents since their last
# training. Retraining is a background job: train -> evaluate -> promote only if it beats the
# active model (registry + rollback). 0 = never (manual or CLI only).
ARCH_MODEL_RETRAIN_MINUTES="60"

# ---------------------------------------------------------------------------
# Observability (optional in development)
# ---------------------------------------------------------------------------
ERROR_TRACKING_DSN=""
LOG_LEVEL="debug"

# ---------------------------------------------------------------------------
# Feature flags (see docs/product/ROADMAP.md — keep v1 surface small)
# ---------------------------------------------------------------------------
# Enable the public status page rendering path. Set to "false" to hide all /status/* routes.
FEATURE_STATUS_PAGES="true"
# Enable outbound Slack notifications (planned for v1.1).
FEATURE_SLACK_NOTIFICATIONS="false"

# ---------------------------------------------------------------------------
# V4 Verified Fix Loop — GitHub + Sandbox (M1-M5)
# ---------------------------------------------------------------------------
# GitHub PAT used to push arch/fix-* branches and open pull requests.
#   classic        scope: repo                (public_repo alone cannot touch private repos)
#   fine-grained   permissions: Contents = Read and write, Pull requests = Read and write
# Put the real value in `.env` (git-ignored) — NEVER in this file. Treat any PAT that has been
# committed as leaked: revoke it at https://github.com/settings/tokens even if the repo was private.
# A placeholder here is ignored at runtime, so copying this file cannot accidentally "configure" GitHub.
#
# The landing page's GitHub star badge uses this setting too: it reads this repository's star count
# (GET /api/github-stars, refreshed at most every 5 minutes, asked of GITHUB_API_BASE_URL). Read access
# is all that is needed. A public repository works without any token (anonymous reads are capped at
# 60/hour per IP; a token lifts that); a private one can only be read with a token that can see it.
# When the count cannot be read the badge shows a plain "Star" - never a made-up number.
# GITHUB_MODE="mock" turns the lookup off entirely (no request is made).
GITHUB_TOKEN="replace-with-a-github-pat"
# "auto" (default) real PRs when GITHUB_TOKEN is set, mocked PRs when it is not.
# "mock" always offline (tests / CI / air-gapped demo) — no network calls at all.
# "real" must reach GitHub; ARCH fails at boot without a token instead of failing at approve time.
# Independent of ARCH_OFFLINE_ONLY on purpose: that flag is the AI privacy lock, while opening a PR is
# a human-approved push, not a model call.
GITHUB_MODE="auto"
# GitHub Enterprise Server: https://ghe.example.com/api/v3 . Must be https in production.
GITHUB_API_BASE_URL="https://api.github.com"
# Deadline for every GitHub API call (branch lookup, blobs, PR creation).
GITHUB_TIMEOUT_MS="20000"
# Open ARCH PRs as drafts, so a human marks them ready before reviewers get pinged.
GITHUB_PR_DRAFT="true"
# Default sandbox timeout for patch verification (ms). M5 safeguard.
SANDBOX_TIMEOUT_MS="30000"
SANDBOX_MAX_OUTPUT_CHARS="20000"
