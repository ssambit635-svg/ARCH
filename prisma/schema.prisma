// ARCH — data model (v1).
//
// Conventions that matter for correctness:
//   * Every tenant-owned model carries `organizationId` (directly, or through a parent that does)
//     and every repository query filters on it. There is no "global" list query.
//   * Timestamps are UTC. `createdAt`/`updatedAt` are managed by Prisma; domain timestamps
//     (`startedAt`, `resolvedAt`, `sentAt`) are managed by services.
//   * Machine-originated rows (webhook ingestion, outbox worker) have no human actor, so
//     `createdById` / `authorId` / `actorId` are nullable and provenance is stored explicitly
//     (`source`, `actorLabel`). Human-originated rows always populate them.
//
// Prisma 7 note: the datasource URL lives in `prisma.config.ts` + the driver adapter
// (`src/lib/db.ts`), not in this file.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum MembershipRole {
  OWNER
  ADMIN
  RESPONDER
  VIEWER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

enum ServiceStatus {
  OPERATIONAL
  DEGRADED
  OUTAGE
  MAINTENANCE
}

enum IncidentEventType {
  STATUS_CHANGED
  SEVERITY_CHANGED
  ASSIGNED
  COMMENT
  LINKED
  CREATED
}

/// Where an incident came from. `WEBHOOK` rows have no human creator.
enum IncidentSource {
  DASHBOARD
  API
  WEBHOOK
}

enum NotificationChannel {
  EMAIL
  SLACK
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationReason {
  INCIDENT_CREATED
  INCIDENT_STATUS_CHANGED
  INCIDENT_ASSIGNED
  INCIDENT_COMMENT
  MEMBER_INVITED
  INVITATION_ACCEPTED
}

/// Outcome of one inbound webhook request. Kept for delivery logs / debugging.
enum WebhookDeliveryStatus {
  ACCEPTED
  DUPLICATE
  REJECTED
  FAILED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

/// V2 — what an ARCH Copilot draft is for (AGENTS-V2.md).
enum AiSuggestionType {
  SUMMARY
  TRIAGE
  STATUS_UPDATE
  POSTMORTEM
  /// V3 — ARCH Code Assist inside an incident: diagnosis + fix for a stack trace / snippet.
  CODE_FIX
  /// V4 — Verified Fix Loop: patch tested in isolated sandbox with evidence bundle.
  VERIFIED_FIX
}

/// V2 — AI output is always a draft until a human approves or dismisses it.
enum AiSuggestionStatus {
  PENDING
  APPROVED
  DISMISSED
}

enum TokenScope {
  READ
  READ_WRITE
}

// ---------- Auth (Auth.js compatible) ----------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  apiTokensCreated  ApiToken[]
  sessions          Session[]
  memberships       Membership[]
  incidentsCreated  Incident[]      @relation("IncidentCreator")
  incidentsAssigned Incident[]      @relation("IncidentAssignee")
  incidentEvents    IncidentEvent[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  invitationsSent   Invitation[]    @relation("InvitationInviter")
  aiSuggestionsCreated  AiSuggestion[] @relation("AiSuggestionCreator")
  aiSuggestionsReviewed AiSuggestion[] @relation("AiSuggestionReviewer")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------- Tenancy & RBAC ----------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  apiTokens        ApiToken[]
  memberships      Membership[]
  invitations      Invitation[]
  projects         Project[]
  incidents        Incident[]
  statusPages      StatusPage[]
  webhookEndpoints WebhookEndpoint[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  aiSuggestions    AiSuggestion[]
  archModel        ArchModel?
  archModelVersions ArchModelVersion[]
  archModelJobs    ArchModelJob[]
  repoConnections  RepoConnection[]
  fixVerifications FixVerification[]
  pullRequests     PullRequest[]
  serviceDependencies ServiceDependency[] @relation("DependencyOrganization")
  changeEvents     ChangeEvent[]
  serviceSlos      ServiceSlo[]
  knowledgeSources KnowledgeSource[]
  modelFeedback    ArchModelFeedback[]
  knowledgeChunks  KnowledgeChunk[]

  @@map("organizations")
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(VIEWER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

/// Email invitation. Token is the only thing emailed; the raw token is never stored.
model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           MembershipRole   @default(RESPONDER)
  status         InvitationStatus @default(PENDING)
  tokenHash      String           @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  invitedById    String?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@map("invitations")
}

// ---------- Catalog ----------

model Project {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  services     Service[]
  incidents    Incident[]
  webhookEndpoints WebhookEndpoint[]
  changeEvents ChangeEvent[]

  @@unique([organizationId, slug])
  @@map("projects")
}

model Service {
  id        String        @id @default(cuid())
  projectId String
  name      String
  slug      String
  description String?
  status    ServiceStatus @default(OPERATIONAL)
  /// When true, `status` is derived from open incidents by the incident service.
  autoStatus Boolean      @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  incidents          Incident[]
  statusPageServices StatusPageService[]
  webhookEndpoints   WebhookEndpoint[]
  dependenciesFrom   ServiceDependency[] @relation("DependencyFrom")
  dependenciesTo     ServiceDependency[] @relation("DependencyTo")
  changeEvents       ChangeEvent[]
  slo               ServiceSlo?

  @@unique([projectId, slug])
  @@index([projectId])
  @@map("services")
}

// ---------- V6 — dependency graph, change correlation and SLO guardian ----------

model ServiceDependency {
  id             String   @id @default(cuid())
  organizationId String
  fromServiceId  String
  toServiceId    String
  relationship   String   @default("DEPENDS_ON")
  criticality    Int      @default(3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation("DependencyOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  fromService  Service @relation("DependencyFrom", fields: [fromServiceId], references: [id], onDelete: Cascade)
  toService    Service @relation("DependencyTo", fields: [toServiceId], references: [id], onDelete: Cascade)

  @@unique([fromServiceId, toServiceId])
  @@index([organizationId])
  @@map("service_dependencies")
}

model ChangeEvent {
  id             String   @id @default(cuid())
  organizationId String
  serviceId      String?
  projectId      String?
  type           String   @default("DEPLOYMENT")
  title          String
  commitSha      String?
  author         String?
  source         String   @default("MANUAL")
  occurredAt     DateTime @default(now())
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([serviceId, occurredAt])
  @@map("change_events")
}

model ServiceSlo {
  id             String   @id @default(cuid())
  organizationId String
  serviceId      String   @unique
  targetPercent  Float    @default(99.9)
  windowDays     Int      @default(30)
  burnAlertPercent Float  @default(50)
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("service_slos")
}

// ---------- Incidents ----------

model Incident {
  id             String           @id @default(cuid())
  organizationId String
  projectId      String
  serviceId      String?
  title          String
  description    String?
  severity       IncidentSeverity @default(MEDIUM)
  status         IncidentStatus   @default(INVESTIGATING)
  source         IncidentSource   @default(DASHBOARD)
  createdById    String?
  assignedToId   String?
  webhookEndpointId String?
  /// Set by webhook ingestion when the sender supplies a stable alert key.
  dedupeKey      String?
  startedAt      DateTime         @default(now())
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("IncidentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo   User?        @relation("IncidentAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  events       IncidentEvent[]
  notifications Notification[]
  webhookDeliveries WebhookDelivery[]
  aiSuggestions AiSuggestion[]
  fixVerifications FixVerification[]
  pullRequests PullRequest[]
  modelFeedback   ArchModelFeedback[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, severity])
  @@index([organizationId, dedupeKey])
  @@index([projectId])
  @@map("incidents")
}

model IncidentEvent {
  id         String            @id @default(cuid())
  incidentId String
  /// Null for machine-originated events (webhook ingestion).
  authorId   String?
  actorLabel String?
  type       IncidentEventType
  body       String?
  metadata   Json?
  createdAt  DateTime          @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author   User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
  @@map("incident_events")
}

// ---------- Status pages ----------

model StatusPage {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String   @unique
  description    String?
  isPublished    Boolean  @default(false)
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  services     StatusPageService[]

  @@index([organizationId])
  @@map("status_pages")
}

model StatusPageService {
  id           String  @id @default(cuid())
  statusPageId String
  serviceId    String
  displayName  String?
  /// Position in the public page listing.
  position     Int     @default(0)

  statusPage StatusPage @relation(fields: [statusPageId], references: [id], onDelete: Cascade)
  service    Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([statusPageId, serviceId])
  @@map("status_page_services")
}

// ---------- Webhooks (ingestion) ----------

model WebhookEndpoint {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  serviceId      String?
  provider       String
  /// Stable public identifier used in the endpoint URL (`?endpoint=<externalId>`).
  externalId     String   @unique
  description    String?
  /// SHA-256 of the signing secret. Used for equality checks and log fingerprints.
  secretHash     String
  /// Signing secret, encrypted at rest (AES-256-GCM, key derived from AUTH_SECRET).
  /// HMAC verification needs the raw key, so a one-way hash alone cannot work.
  secretEncrypted String
  isActive       Boolean  @default(true)
  lastDeliveryAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  deliveries   WebhookDelivery[]

  @@unique([provider, externalId])
  @@index([organizationId])
  @@map("webhook_endpoints")
}

/// One row per inbound webhook request: the delivery log + the idempotency ledger.
model WebhookDelivery {
  id          String                @id @default(cuid())
  endpointId  String
  /// Dedupe key: `x-arch-delivery-id` (or a provider-specific header, else a body hash).
  deliveryKey String
  status      WebhookDeliveryStatus
  httpStatus  Int
  incidentId  String?
  error       String?
  payload     Json?
  receivedAt  DateTime              @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  incident Incident?       @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@unique([endpointId, deliveryKey])
  @@index([endpointId, receivedAt])
  @@map("webhook_deliveries")
}

// ---------- Observability ----------

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  /// Null for machine-originated actions (webhooks, worker).
  actorId        String?
  actorLabel     String?
  action         String
  entityType     String
  entityId       String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, action])
  @@map("audit_logs")
}

/// Transactional outbox: written inside the same transaction as the domain change, drained by
/// the worker process (`npm run worker`). No Redis, no in-process fire-and-forget.
model Notification {
  id             String               @id @default(cuid())
  organizationId String
  incidentId     String?
  recipientId    String
  channel        NotificationChannel   @default(EMAIL)
  status         NotificationStatus    @default(PENDING)
  reason         NotificationReason
  subject        String
  body           String
  attempts       Int                  @default(0)
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incident     Incident?    @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  recipient    User         @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([organizationId, createdAt])
  @@map("notifications")
}

// ---------- ARCH Copilot (V2) ----------

/// One AI-generated draft. Never applied to an incident, status page or notification until a
/// human with RESPONDER+ approves it. Dismissed drafts are kept for the audit trail.
model AiSuggestion {
  id               String             @id @default(cuid())
  organizationId   String
  incidentId       String
  type             AiSuggestionType
  status           AiSuggestionStatus @default(PENDING)
  /// Provider + model that produced the draft ("mock", "openai", "anthropic").
  provider         String
  model            String
  promptTokens     Int                @default(0)
  completionTokens Int                @default(0)
  latencyMs        Int?
  /// Validated, post-processed draft. Shape depends on `type` (see src/server/ai/schemas.ts).
  output           Json
  createdById      String?
  createdAt        DateTime           @default(now())
  reviewedById     String?
  reviewedAt       DateTime?
  /// Timeline event created when an approved draft was posted to the incident.
  appliedEventId   String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incident     Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("AiSuggestionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy   User?        @relation("AiSuggestionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  fixVerifications FixVerification[]

  @@index([organizationId, incidentId, createdAt])
  @@index([incidentId, status])
  @@map("ai_suggestions")
}

/// V3 — ARCH's own model, trained per organization on its resolved incidents (plus the built-in
/// pattern library, optional public postmortems and the code/review corpora). One row per
/// organization holding the ACTIVE model; every training run is also kept in `ArchModelVersion`
/// (the registry), so versions can be compared, rolled back and audited. `artifact` holds
/// redacted snippets only — see src/server/ai/arch-model/train.ts.
model ArchModel {
  id             String   @id @default(cuid())
  organizationId String   @unique
  /// Registry version number of the model currently serving this organization.
  version        Int      @default(1)
  name           String
  format         Int
  trainedAt      DateTime
  teamDocuments  Int      @default(0)
  totalDocuments Int      @default(0)
  metrics        Json
  artifact       Json
  trainedById    String?
  /// Registry row currently serving this organization (null for pre-registry models).
  activeVersionId String? @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activeVersion ArchModelVersion? @relation(fields: [activeVersionId], references: [id], onDelete: SetNull)

  @@map("arch_models")
}

/// V3 model registry — one row per training run. Versions are never overwritten: a new run adds a
/// new row, is evaluated against the active model, and is promoted only if it beats it.
/// `status`: ACTIVE (serving now) | SUPERSEDED (was active, replaced) | REJECTED (lost evaluation).
model ArchModelVersion {
  id             String   @id @default(cuid())
  organizationId String
  /// Per-organization counter, monotonically increasing.
  version        Int
  status         String
  name           String
  format         Int
  trainedAt      DateTime
  teamDocuments  Int      @default(0)
  totalDocuments Int      @default(0)
  metrics        Json
  artifact       Json
  /// Why this version exists and how it fared: { score, incumbentVersion, incumbentScore,
  /// promoted, reason }.
  evaluation     Json     @default("{}")
  /// manual | scheduled | cli
  trigger        String   @default("manual")
  trainedById    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activeFor    ArchModel?

  @@unique([organizationId, version])
  @@index([organizationId, createdAt])
  @@map("arch_model_versions")
}

/// V3 background training queue (Postgres outbox, same pattern as notifications). The web process
/// only enqueues; the worker claims PENDING rows, trains, evaluates and promotes — never inside a
/// web request.
model ArchModelJob {
  id             String    @id @default(cuid())
  organizationId String
  /// PENDING | RUNNING | COMPLETED | FAILED
  status         String    @default("PENDING")
  /// manual | scheduled
  trigger        String    @default("manual")
  requestedById  String?
  error          String?
  /// Registry version produced by this job, once completed.
  versionId      String?
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([organizationId, createdAt])
  @@map("arch_model_jobs")
}

// ---------- V4 — Verified Fix Loop (GitHub repo connect + sandbox verification + PR) ----------

/// V4 — GitHub repository linked to an organization. RBAC enforced: OWNER/ADMIN manage, all roles read.
/// Commit pinning: `pinnedCommitSha` is the exact commit the fix was tested against (repo@commit checkout).
model RepoConnection {
  id             String   @id @default(cuid())
  organizationId String
  provider       String   @default("github")
  owner          String
  repo           String
  fullName       String
  defaultBranch  String   @default("main")
  /// Exact commit SHA the organization pinned for verified fixes (40 hex chars, or short SHA for display).
  pinnedCommitSha String?
  isActive       Boolean  @default(true)
  connectedById  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  verifications FixVerification[]
  pullRequests PullRequest[]

  @@unique([organizationId, fullName])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("repo_connections")
}

/// V4 — One sandbox run for a proposed patch. Isolated: no prod credentials, temporary container, timeout.
/// Evidence bundle is stored in `evidence` JSON (diff, test results, timings, safety checks).
model FixVerification {
  id               String   @id @default(cuid())
  organizationId   String
  incidentId       String
  suggestionId     String
  repoConnectionId String?
  /// Commit SHA this verification ran against (pinned at verification time).
  commitSha        String?
  /// Unified diff or improved code that was tested.
  patch            String
  /// PENDING | RUNNING | PASSED | FAILED | TIMEOUT | UNSAFE | ERROR
  status           String   @default("PENDING")
  testCommand      String?
  testOutput       String?
  /// Evidence bundle: { sandboxId, startedAt, finishedAt, durationMs, safetyChecks, commitSha, patchHash, testCommand, testResults, logs }
  evidence         Json?
  /// V6 — the generated reproduction test that was written into the sandbox (always reviewed by a human).
  reproductionTest String?
  /// V6 — reproduction evidence: { ran, reason?, failedBeforePatch, passedAfterPatch, beforeOutput, afterOutput }
  reproduction     Json?
  durationMs       Int?
  createdById      String?
  createdAt        DateTime @default(now())
  finishedAt       DateTime?

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incident       Incident        @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  suggestion     AiSuggestion    @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  repoConnection RepoConnection? @relation(fields: [repoConnectionId], references: [id], onDelete: SetNull)
  pullRequest    PullRequest?

  @@index([organizationId, incidentId])
  @@index([suggestionId])
  @@index([repoConnectionId])
  @@index([organizationId, status])
  @@map("fix_verifications")
}

/// V4 — Pull request created only after human approval of a verified fix. Audit logged.
model PullRequest {
  id               String   @id @default(cuid())
  organizationId   String
  incidentId       String
  suggestionId     String?
  verificationId   String?  @unique
  repoConnectionId String
  title            String
  body             String?
  branch           String
  baseBranch       String   @default("main")
  commitSha        String?
  patch            String?
  /// CREATED | OPEN | MERGED | CLOSED
  status           String   @default("OPEN")
  /// Mock or real GitHub PR URL (offline mode returns a fake URL, still audited).
  externalUrl      String?
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incident       Incident        @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  repoConnection RepoConnection  @relation(fields: [repoConnectionId], references: [id], onDelete: Cascade)
  verification   FixVerification? @relation(fields: [verificationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([incidentId])
  @@index([repoConnectionId])
  @@map("pull_requests")
}

model ApiToken {
  id             String     @id @default(cuid())
  organizationId String
  name           String
  prefix         String
  hash           String     @unique
  scopes         Json
  createdById    String
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime   @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([organizationId, revokedAt])
  @@index([prefix])
  @@map("api_tokens")
}

// ---------- V6 — RAG knowledge sources + learning feedback (ARCH's own retrieval, on your server) ----------

/// Where a knowledge document came from. Runbooks and docs are the point: ARCH answers from YOUR
/// operational knowledge, fetched once at ingest time and never leaving the server.
enum KnowledgeSourceKind {
  RUNBOOK
  DOC
  NOTE
  URL
  INCIDENT_EXPORT
}

/// PENDING (queued for indexing) | READY (chunked + embedded) | FAILED (see `error`)
enum KnowledgeSourceStatus {
  PENDING
  READY
  FAILED
}

/// A document ARCH can retrieve from. Raw text is chunked and embedded at ingest; only the chunks
/// are kept, so the source can be deleted without a trace in the model.
model KnowledgeSource {
  id             String                @id @default(cuid())
  organizationId String
  name           String
  kind           KnowledgeSourceKind   @default(DOC)
  status         KnowledgeSourceStatus @default(PENDING)
  /// Public URL this was fetched from (kind URL), or null for pasted text.
  sourceUrl      String?
  /// sha256 of the normalized text — re-ingesting identical content is a no-op.
  contentHash    String?
  chunkCount     Int                   @default(0)
  tokenCount     Int                   @default(0)
  error          String?
  createdById    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chunks       KnowledgeChunk[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("knowledge_sources")
}

/// One retrievable piece of a knowledge source. `embedding` is a dense vector produced by ARCH's
/// own embedding space (Random Indexing over the organization's corpus) — no external embedding
/// API, no network, no third-party model.
model KnowledgeChunk {
  id             String   @id @default(cuid())
  organizationId String
  sourceId       String
  ordinal        Int
  heading        String?
  text           String
  tokenCount     Int      @default(0)
  embedding      Json
  createdAt      DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source       KnowledgeSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([organizationId, sourceId])
  @@index([sourceId, ordinal])
  @@map("knowledge_chunks")
}

/// What humans taught the model. Every row is a label the next training run can use: a draft that
/// was edited, a severity a responder corrected, a draft that was thrown away.
enum ArchModelFeedbackKind {
  DRAFT_EDITED
  DRAFT_APPROVED
  DRAFT_DISMISSED
  SEVERITY_CORRECTED
  CATEGORY_CORRECTED
}

/// V6 active learning. Feedback is captured from ordinary product use (approve / edit / dismiss /
/// severity change) — no extra work for responders — and folded into the next training run.
model ArchModelFeedback {
  id             String                @id @default(cuid())
  organizationId String
  incidentId     String?
  suggestionId   String?
  /// summary | triage | status_update | postmortem | code_fix | verified_fix | severity
  task           String
  kind           ArchModelFeedbackKind
  /// What the model produced (redacted).
  original       Json?
  /// What the human settled on (redacted).
  corrected      Json?
  createdById    String?
  createdAt      DateTime              @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incident     Incident?    @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, task, kind])
  @@map("arch_model_feedback")
}
