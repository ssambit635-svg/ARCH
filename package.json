{
  "name": "arch",
  "version": "0.3.0",
  "private": true,
  "description": "ARCH — multi-tenant incident management + public status pages for developer teams.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:next": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "dev:all": "node scripts/dev.mjs",
    "worker": "tsx src/worker/main.ts",
    "setup": "node scripts/setup.mjs",
    "db:generate": "node scripts/prisma-cli.mjs generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:reset": "node scripts/db-migrate.mjs --reset",
    "db:seed": "tsx scripts/seed.ts",
    "webhooks:rekey": "tsx scripts/rekey-webhooks.ts",
    "db:up": "node scripts/dev-db.mjs start",
    "db:down": "node scripts/dev-db.mjs stop",
    "db:status": "node scripts/dev-db.mjs status",
    "github:check": "tsx scripts/github-check.ts",
    "github:debug": "tsx scripts/github/repo-debug.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:watch": "vitest",
    "model:fetch-public": "node scripts/arch-model/fetch-public-incidents.mjs",
    "model:fetch-code": "node scripts/arch-model/fetch-code-corpus.mjs",
    "model:fetch-review": "node scripts/arch-model/fetch-review-corpus.mjs",
    "model:fetch-all": "npm run model:fetch-public && npm run model:fetch-code && npm run model:fetch-review",
    "knowledge:fetch": "tsx scripts/arch-model/fetch-knowledge.mjs",
    "model:train": "tsx scripts/arch-model/train.ts",
    "model:eval": "tsx scripts/arch-model/eval.ts",
    "model:export-finetune": "tsx scripts/arch-model/export-finetune.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@octokit/rest": "22.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "dotenv": "18.0.3",
    "next": "16.3.6",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "embedded-postgres": "18.4.0-beta.17",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "overrides": {
    "mysql2": "3.24.4",
    "deepmerge-ts": "8.0.2"
  }
}
